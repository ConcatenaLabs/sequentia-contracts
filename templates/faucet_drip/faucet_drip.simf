/* The faucet drip covenant: a reserve that pays out at most one tier per
 * interval, to whatever the faucet key signs for.
 *
 * The output is
 *
 *     P2TR(NUMS, TapBranch(TapBranch(TapLeaf_0xbe(CMR), H_TapData(params)),
 *                          TapLeaf_0xc4(<RECOVERY_DELAY> CSV DROP <TREASURY_KEY> CHECKSIG)))
 *
 * This program is the Simplicity leaf, the drip. Its parameters sit in the
 * data leaf beside it, in this order: the asset, the faucet key, the interval
 * (in units of 512 seconds), the fee cap, and the tier table: three floors,
 * each with the most a drip may pay while the reserve holds at least that
 * floor, and the most below the last floor. The spender gives them in the
 * witness and the program checks them against the data leaf, which consensus
 * has bound to the output through the control block.
 *
 * A drip spends the reserve, input 0, and pays:
 *   output 1  the drip: at most the tier for the reserve's amount, in the asset,
 *             to any script but this one;
 *   fees      at most the fee cap in the asset;
 *   output 0  the successor: this same script, the same asset, and exactly the
 *             reserve less the drip and the fee, explicitly and with no nonce.
 * The reserve's input must have waited the interval since its coin confirmed,
 * by its own sequence, so each successor waits again; and the faucet key signs
 * the whole transaction. Only input 0 can be a reserve, so two reserve coins
 * cannot share one successor. Whatever the faucet key signs, the reserve loses
 * at most one tier and one fee cap per interval.
 *
 * The recovery leaf is a tapscript the descriptor builds: the treasury key
 * takes everything once the reserve has gone RECOVERY_DELAY without a drip.
 */
// include output_reader
// include relative_lock
// include fee_cap

/* The data leaf's hash over the parameters, in the template's order. */
fn params_tapdata(asset: u256, key: Pubkey, interval: u16, cap: u64, floors: (u64, u64, u64), maxes: (u64, u64, u64, u64)) -> u256 {
    let (f1, f2, f3): (u64, u64, u64) = floors;
    let (m1, m2, m3, m4): (u64, u64, u64, u64) = maxes;
    let ctx: Ctx8 = jet::tapdata_init();
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, asset);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, key);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_2(ctx, interval);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_8(ctx, cap);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_8(ctx, f1);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_8(ctx, m1);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_8(ctx, f2);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_8(ctx, m2);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_8(ctx, f3);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_8(ctx, m3);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_8(ctx, m4);
    jet::sha_256_ctx_8_finalize(ctx)
}

/* The most a drip may pay from a reserve of `reserve`. */
fn tier(reserve: u64, floors: (u64, u64, u64), maxes: (u64, u64, u64, u64)) -> u64 {
    let (f1, f2, f3): (u64, u64, u64) = floors;
    let (m1, m2, m3, m4): (u64, u64, u64, u64) = maxes;
    match jet::le_64(f1, reserve) {
        true => m1,
        false => match jet::le_64(f2, reserve) {
            true => m2,
            false => match jet::le_64(f3, reserve) {
                true => m3,
                false => m4,
            },
        },
    }
}

/* a - b; refuses a difference below zero. */
fn minus(a: u64, b: u64) -> u64 {
    let (borrow, d): (bool, u64) = jet::subtract_64(a, b);
    assert!(jet::eq_1(<bool>::into(borrow), 0));
    d
}

fn main() {
    let asset: u256 = witness::ASSET;
    let key: Pubkey = witness::FAUCET_KEY;
    let interval: u16 = witness::INTERVAL;
    let cap: u64 = witness::FEE_CAP;
    let floors: (u64, u64, u64) = (witness::TIER1_FLOOR, witness::TIER2_FLOOR, witness::TIER3_FLOOR);
    let maxes: (u64, u64, u64, u64) = (witness::TIER1_MAX, witness::TIER2_MAX, witness::TIER3_MAX, witness::TIER4_MAX);

    // The parameters are the data leaf's.
    assert!(jet::eq_256(params_tapdata(asset, key, interval, cap, floors, maxes), unwrap(jet::tappath(0))));

    // One reserve per transaction: this input is input 0, and its successor output 0.
    assert!(jet::eq_32(jet::current_index(), 0));

    // The reserve holds the template's asset, explicitly.
    let (held, reserve): (u256, u64) = in_explicit_current();
    assert!(jet::eq_256(held, asset));

    // One drip per interval, by this input's own sequence.
    rel_lock_time(interval);

    // The drip: output 1, in the asset, at most the tier, and not back into this script.
    let (drip_asset, drip, drip_script): (u256, u64, u256) = out_explicit(1);
    assert!(jet::eq_256(drip_asset, asset));
    assert!(jet::le_64(drip, tier(reserve, floors, maxes)));
    let here: u256 = jet::current_script_hash();
    assert!(jet::eq_1(<bool>::into(jet::eq_256(drip_script, here)), 0));

    // The fee, in the asset, at most the cap.
    fee_cap_require(asset, cap);

    // The successor: this script, the asset, and exactly what is left.
    let left: u64 = minus(minus(reserve, drip), jet::total_fee(asset));
    out_require(0, asset, left, here);

    // The faucet key signs the whole transaction.
    jet::bip_0340_verify((key, jet::sig_all_hash()), witness::SIG);
}
