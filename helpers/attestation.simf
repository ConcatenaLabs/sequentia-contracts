/* Price attestation, format 2: the digest a signer signs, rebuilt from the
 * fields a contract uses, and the signature checked over it.
 *
 *   message = version (1) || key (32) || base (32) || quote (32)
 *             || price (8, LE) || precision (1) || time (4, LE) || beacon (32)
 *   digest  = SHA256(SHA256(TAG) || SHA256(TAG) || message),
 *             TAG = "Sequentia/oracle/price"
 *
 * The format is owned by sequentia-oracle (doc/format.md there). Integers are
 * little-endian in the message, the order tapscript's 64-bit opcodes use; a
 * SimplicityHL integer is big-endian, so the helper reverses the bytes of
 * `price` and `time` before hashing them, which costs combinators only.
 * Asset ids are in internal byte order, as jet::current_asset gives them.
 * Include with `// include attestation`.
 */

fn att_le16(x: u16) -> u16 {
    let (a, b): (u8, u8) = <u16>::into(x);
    <(u8, u8)>::into((b, a))
}

fn att_le32(x: u32) -> u32 {
    let (a, b): (u16, u16) = <u32>::into(x);
    <(u16, u16)>::into((att_le16(b), att_le16(a)))
}

fn att_le64(x: u64) -> u64 {
    let (a, b): (u32, u32) = <u64>::into(x);
    <(u32, u32)>::into((att_le32(b), att_le32(a)))
}

/* The 32 bytes a format-2 attestation's BIP340 signature is over. */
fn att_digest(key: u256, base: u256, quote: u256, price: u64, precision: u8, time: u32, beacon: u256) -> u256 {
    let tag: u256 = 0xc04934780078514d7ab2e52cded2406ac154a043874d7121dadd61942b2ca91c;
    let ctx: Ctx8 = jet::sha_256_ctx_8_init();
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, tag);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, tag);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_1(ctx, 2);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, key);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, base);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, quote);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_8(ctx, att_le64(price));
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_1(ctx, precision);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, att_le32(time));
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, beacon);
    jet::sha_256_ctx_8_finalize(ctx)
}

/* `sig` is `key`'s format-2 attestation of exactly these fields. The key
 * signs its own name into the message, so a contract passes the one key it
 * pins for both. */
fn att_verify(key: Pubkey, base: u256, quote: u256, price: u64, precision: u8, time: u32, beacon: u256, sig: Signature) {
    jet::bip_0340_verify((key, att_digest(key, base, quote, price, precision, time, beacon)), sig);
}
