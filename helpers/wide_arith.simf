/* Wide arithmetic: 128-bit products, sums and comparisons from 64-bit jets.
 *
 * Signed 64-bit script arithmetic fails on overflow; these helpers keep the
 * full product and refuse any result that does not fit, so a contract never
 * wraps silently. Include with `// include wide_arith`.
 */

/* a * b, all 128 bits. */
fn wide_mul(a: u64, b: u64) -> u128 {
    jet::multiply_64(a, b)
}

/* a + b; refuses a sum that does not fit in 128 bits. */
fn wide_add(a: u128, b: u128) -> u128 {
    let (ah, al): (u64, u64) = <u128>::into(a);
    let (bh, bl): (u64, u64) = <u128>::into(b);
    let (carry, lo): (bool, u64) = jet::add_64(al, bl);
    let (overflow, hi): (bool, u64) = jet::full_add_64(carry, ah, bh);
    match overflow {
        true => panic!(),
        false => <(u64, u64)>::into((hi, lo)),
    }
}

/* a < b. */
fn wide_lt(a: u128, b: u128) -> bool {
    let (ah, al): (u64, u64) = <u128>::into(a);
    let (bh, bl): (u64, u64) = <u128>::into(b);
    match jet::eq_64(ah, bh) {
        true => jet::lt_64(al, bl),
        false => jet::lt_64(ah, bh),
    }
}

/* a <= b. */
fn wide_le(a: u128, b: u128) -> bool {
    match wide_lt(b, a) {
        true => false,
        false => true,
    }
}

/* a - b; refuses a difference below zero. */
fn wide_sub(a: u128, b: u128) -> u128 {
    let (ah, al): (u64, u64) = <u128>::into(a);
    let (bh, bl): (u64, u64) = <u128>::into(b);
    let (borrow, lo): (bool, u64) = jet::subtract_64(al, bl);
    let (underflow, hi): (bool, u64) = jet::full_subtract_64(borrow, ah, bh);
    match underflow {
        true => panic!(),
        false => <(u64, u64)>::into((hi, lo)),
    }
}

/* Checks that q = floor(a * b / c) and returns it. The spender supplies q;
 * the helper checks q * c <= a * b < (q + 1) * c with the product kept at 128
 * bits, which refuses c = 0.
 *
 * Division is verified rather than computed because jet::div_mod_128_64 is
 * defined only for a divisor of at least 2^63 whose quotient fits in 64 bits;
 * outside that it returns all ones. A division by an ordinary scale, such as
 * 10^8, therefore cannot use it directly. */
fn wide_mul_div(a: u64, b: u64, c: u64, q: u64) -> u64 {
    let remainder: u128 = wide_sub(jet::multiply_64(a, b), jet::multiply_64(q, c));
    let (rh, rl): (u64, u64) = <u128>::into(remainder);
    assert!(jet::eq_64(rh, 0));
    assert!(jet::lt_64(rl, c));
    q
}
