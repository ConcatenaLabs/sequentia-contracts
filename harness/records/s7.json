 "source": "/* S7: arithmetic and an oracle.\n *\n * The lender may take the collateral held by this output when an oracle-signed\n * price shows it is under-collateralised:\n *\n *        collateral_amount * price  <  DEBT * THRESHOLD        (128-bit products)\n *\n *   1. ORACLE signed  SHA256(\"ArcaOrc1\" || asset_id(32) || price_be8 || timestamp_be4)\n *      where asset_id is the EXPLICIT asset of the coin being spent (read from\n *      the transaction, so a price for another asset cannot be used);\n *   2. the statement is not older than NOT_BEFORE;\n *   3. the inequality, with jet::multiply_64 : (u64, u64) -> u128 and a 128-bit\n *      comparison built from 64-bit jets (there is no lt_128 jet);\n *   4. LENDER signs the transaction (sig_all_hash).\n */\nfn lt_128(a: u128, b: u128) -> bool {\n    let (ah, al): (u64, u64) = <u128>::into(a);\n    let (bh, bl): (u64, u64) = <u128>::into(b);\n    let hi_lt: u1 = <bool>::into(jet::lt_64(ah, bh));\n    let hi_eq: u1 = <bool>::into(jet::eq_64(ah, bh));\n    let lo_lt: u1 = <bool>::into(jet::lt_64(al, bl));\n    <u1>::into(jet::or_1(hi_lt, jet::and_1(hi_eq, lo_lt)))\n}\n\nfn main() {\n    let price: u64 = witness::PRICE;\n    let ts: u32 = witness::TIMESTAMP;\n    let (a, v): (Asset1, Amount1) = jet::current_amount();\n    let asset: u256 = unwrap_right::<(u1, u256)>(a);\n    let collateral: u64 = unwrap_right::<(u1, u256)>(v);\n\n    let ctx: Ctx8 = jet::sha_256_ctx_8_init();\n    let ctx: Ctx8 = jet::sha_256_ctx_8_add_8(ctx, 0x417263614f726331);\n    let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, asset);\n    let ctx: Ctx8 = jet::sha_256_ctx_8_add_8(ctx, price);\n    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, ts);\n    let msg: u256 = jet::sha_256_ctx_8_finalize(ctx);\n    jet::bip_0340_verify((param::ORACLE, msg), witness::ORACLE_SIG);\n\n    assert!(jet::le_32(param::NOT_BEFORE, ts));\n    assert!(lt_128(jet::multiply_64(collateral, price), jet::multiply_64(param::DEBT, param::THRESHOLD)));\n\n    jet::bip_0340_verify((param::LENDER, jet::sig_all_hash()), witness::LENDER_SIG);\n}\n",
