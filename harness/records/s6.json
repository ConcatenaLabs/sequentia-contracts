 "source/lock_distance": "/* Refused: the relative-height jet, used the way its name suggests. It reads\n * the largest relative lock over EVERY input, so a spender adds an old coin of\n * their own and spends this output at once. The regtest harness runs it only\n * to prove that bypass. */\nfn main() {\n    jet::broken_do_not_use_check_lock_distance(param::N)\n}\n",
 "source/lock_duration": "/* Refused: the relative-time jet (units of 512 seconds), with the same defect\n * as the height form. The regtest harness runs it only to prove the bypass. */\nfn main() {\n    jet::broken_do_not_use_check_lock_duration(param::N)\n}\n",
 "source/lock_probe": "/* Refused: reads tx_lock_distance and tx_lock_duration, the transaction-wide\n * maxima behind the broken lock jets. The regtest harness runs it to measure\n * what each lock-related jet returns: the program is accepted only if every\n * witness value equals what the jet returned. */\nfn main() {\n    assert!(jet::eq_16(jet::broken_do_not_use_tx_lock_distance(), witness::DIST));\n    assert!(jet::eq_16(jet::broken_do_not_use_tx_lock_duration(), witness::DUR));\n    assert!(jet::eq_32(jet::tx_lock_height(), witness::HEIGHT));\n    assert!(jet::eq_32(jet::tx_lock_time(), witness::TIME));\n    assert!(jet::eq_32(jet::current_sequence(), witness::SEQ));\n    assert!(jet::eq_32(jet::version(), witness::VERSION));\n    assert!(jet::eq_1(<bool>::into(jet::tx_is_final()), witness::FINAL));\n}\n",
 "source/safe_distance": "/* A relative-height lock that binds THIS input. BIP68 makes consensus\n * enforce an input's own nSequence only when the transaction version is >= 2\n * and bit 31 of that nSequence is clear, so the program checks exactly that:\n * version >= 2, own sequence parses as a block distance, distance >= N. */\nfn main() {\n    assert!(jet::le_32(2, jet::version()));\n    let d: u16 = match unwrap(jet::parse_sequence(jet::current_sequence())) {\n        Left(blocks: u16) => blocks,\n        Right(units: u16) => panic!(),\n    };\n    assert!(jet::le_16(param::N, d));\n}\n",
 "source/safe_duration": "/* The same as safe_distance.simf for a relative TIME lock (units of 512 seconds). */\nfn main() {\n    assert!(jet::le_32(2, jet::version()));\n    let d: u16 = match unwrap(jet::parse_sequence(jet::current_sequence())) {\n        Left(blocks: u16) => panic!(),\n        Right(units: u16) => units,\n    };\n    assert!(jet::le_16(param::N, d));\n}\n",
